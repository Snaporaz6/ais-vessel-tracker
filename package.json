{
  "name": "ais-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "AIS Vessel Tracker — free alternative to MarineTraffic",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "start": "node dist/server/index.js",
    "start:snapshot": "node dist/scripts/serve-snapshot.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test": "tsx --test tests/*.test.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm --prefix frontend run typecheck && npm run build:frontend",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "migrate:legacy": "tsx scripts/migrate-legacy.ts",
    "sync:sanctions": "tsx scripts/sync-sanctions.ts",
    "monitor:beta": "tsx scripts/monitor-beta.ts",
    "backup:prod": "node dist/scripts/backup.js",
    "restore:prod": "node dist/scripts/restore.js",
    "migrate:legacy:prod": "node dist/scripts/migrate-legacy.js",
    "sync:sanctions:prod": "node dist/scripts/sync-sanctions.js",
    "monitor:beta:prod": "node dist/scripts/monitor-beta.js",
    "preflight:prod": "node dist/scripts/preflight.js",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@supabase/supabase-js": "^2.39.0",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.1.5",
    "fast-xml-parser": "^5.11.2",
    "geolib": "^3.3.4",
    "helmet": "^7.1.0",
    "node-cron": "^4.6.0",
    "ws": "^8.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
