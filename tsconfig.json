{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "ingestor/**/*.ts",
    "api/**/*.ts",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "storage/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "frontend"]
}
