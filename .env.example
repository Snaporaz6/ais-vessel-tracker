# SOLO BACKEND — copiare in .env.local; mai in Git/Vercel frontend
NODE_ENV=development
API_PORT=3001
DEMO_MODE=false
STORAGE_DIR=./data
# Inferiore alla capacità del volume, lasciando spazio per scritture atomiche e checkpoint.
STORAGE_MAX_BYTES=4294967296
CORS_ORIGINS=http://localhost:3000
INGESTOR_BBOX=30,-6,46,36.5
AISSTREAM_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Almeno 24 caratteri; obbligatorio in produzione
ADMIN_TOKEN=
# Opzionale: fissa una versione consolidata; senza override si scopre la più recente dall'indice EUR-Lex.
# Usare il comportamento automatico in produzione per seguire le nuove versioni.
# EU_SANCTIONS_URL=
